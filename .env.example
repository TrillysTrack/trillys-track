# Auto-filled by Vercel once you connect a Postgres database (Storage tab).
# You don't set these by hand — Vercel injects them.
POSTGRES_URL=

# Optional. Only needed to enable "Pull race", "Enrich", and "Pink Sheet" (AI features).
# Get one at https://console.anthropic.com — billed separately, per-token, from your
# claude.ai subscription. Without this, everything else in the dashboard still works:
# manual entry, CSV import (including the PowerShell NYRA scraper), the model, bets,
# performance tracking. Set this in Vercel → Settings → Environment Variables.
# The Mention Desk (/mentions) also uses it for "Find transcripts" and "Ask Claude".
ANTHROPIC_API_KEY=

# Mention Desk. Any long random string; required for Kalshi portfolio sync and, when set,
# also gates the Claude and transcript-fetch endpoints. Enter the same value in the desk's
# Settings tab.
DASHBOARD_TOKEN=

# Mention Desk portfolio sync (read-only). From Kalshi → Account → API keys.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=

# Optional: point at Kalshi's demo environment instead of production.
# KALSHI_API_BASE=https://demo-api.kalshi.co/trade-api/v2
